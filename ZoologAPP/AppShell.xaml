<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ZoologAPP.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ZoologAPP"
    Title="ZoologAPP">

    <!--08.07.2026 Alexander Stojek (Icons): 5-Tab-Struktur mit Icons (Symbol über der Beschriftung). -->
    <TabBar>
        <ShellContent Title="Start"      Icon="tab_start.png"       ContentTemplate="{DataTemplate local:HomePage}"        Route="start" />
        <ShellContent Title="Sammlungen" Icon="tab_collections.png" ContentTemplate="{DataTemplate local:CollectionsPage}" Route="collections" />
        <ShellContent Title="Suche"      Icon="tab_search.png"      ContentTemplate="{DataTemplate local:SearchPage}"      Route="search" />
        <ShellContent Title="Fundorte"   Icon="tab_fundorte.png"    ContentTemplate="{DataTemplate local:LocationsPage}"   Route="locations" />
        <ShellContent Title="Mehr"       Icon="tab_more.png"        ContentTemplate="{DataTemplate local:MorePage}"        Route="more" />
    </TabBar>

</Shell>